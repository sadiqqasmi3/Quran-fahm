# Quran Feham V2 local development values.
# Copy to .env and replace every production secret in the deployment secret store.

NODE_ENV=development

# Public/local ports. Container-to-container ports stay fixed at web 3000,
# API 4000 and PostgreSQL 5432.
WEB_BIND=127.0.0.1
WEB_PORT=3000
API_BIND=127.0.0.1
API_PORT=4000
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
TRAEFIK_BIND=127.0.0.1
TRAEFIK_HTTP_PORT=8080

# Required database system of record.
POSTGRES_DB=quran_feham
POSTGRES_USER=quran_feham
POSTGRES_PASSWORD=quran-feham-local-only
DATABASE_URL=postgresql://quran_feham:quran-feham-local-only@127.0.0.1:5432/quran_feham

# Host development web proxy. Compose overrides this to http://api:4000.
QURAN_FEHAM_API_ORIGIN=http://127.0.0.1:4000
# Public canonical origin used in shareable Khatm invitation links.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Authentication. These local examples are intentionally rejected by a
# production runtime; production values must be unique high-entropy secrets.
JWT_SECRET=development-only-change-this-jwt-secret
REFRESH_TOKEN_PEPPER=development-only-change-this-refresh-pepper
OTP_PEPPER=development-only-change-this-otp-pepper
JWT_ISSUER=quran-feham-api
JWT_AUDIENCE=quran-feham-web
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
ACCESS_TTL_SECONDS=600
REFRESH_TTL_SECONDS=2592000
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
SECURE_COOKIES=false
REQUIRE_ORIGIN=false
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000
GENERIC_AUTH_RESPONSE_MS=750
EXPOSE_ACCESS_TOKEN=false
EXPOSE_DEVELOPMENT_CODES=true
TRUST_PROXY=linklocal,uniquelocal

# Required in production for verification, password-reset, and Khatm reminder email.
# Can use standard host/port or a service preset like 'gmail'.
# For Gmail: SMTP_SERVICE=gmail, SMTP_USER=you@gmail.com, SMTP_PASS=<app-password>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASS=
SMTP_SERVICE=
SMTP_FROM="Quran Feham <noreply@fehmequran.org>"
AUTH_EMAIL_FROM="Quran Feham <noreply@fehmequran.org>"

# Container-only SMTP host. Use `mailpit` for the local Compose mail profile;
# production must replace it with the reviewed provider endpoint.
CONTAINER_SMTP_HOST=mailpit

# Optional Redis profile. Redis is not used by the core runtime yet.
REDIS_BIND=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=quran-feham-redis-local-only

# Optional Mailpit profile. Mailpit is a local inbox; production must use a
# reviewed SMTP provider and monitored delivery credentials.
MAILPIT_BIND=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=500
